    {
      "id": "9WqedKt4UZ2TSo8HkDaZe",
      "type": "text",
      "x": 1384.1917108446182,
      "y": 619.950815089624,
      "width": 586.6396484375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 984302735,
      "version": 401,
      "versionNonce": 102874305,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776687577824,
      "link": null,
      "locked": false,
      "text": "An importer consists of two parts:\n- what we will call an extractor that, regarding its category\n  will retrieve all the data in a raw format for the category.\n- what we will call a crafter that turn the raw material into\n  a resource.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An importer consists of two parts:\n- what we will call an extractor that, regarding its category\n  will retrieve all the data in a raw format for the category.\n- what we will call a crafter that turn the raw material into\n  a resource.",
      "autoResize": true,
      "lineHeight": 1.25
    },
