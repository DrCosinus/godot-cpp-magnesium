      "isDeleted": false,
      "boundElements": null,
      "updated": 1776698201546,
      "link": null,
      "locked": false,
      "text": "Serializable is an abstract class\nto realize to be easily serializable\nby a Serializer.\nI has a single abstract method Serialize,\nwith a reference to a Serializer has paremeter.\nThis method manages both the serialization\nand the deserialization. The method can know\nthe direction of the serializer calling its method\nIsWriting().",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serializable is an abstract class\nto realize to be easily serializable\nby a Serializer.\nI has a single abstract method Serialize,\nwith a reference to a Serializer has paremeter.\nThis method manages both the serialization\nand the deserialization. The method can know\nthe direction of the serializer calling its method\nIsWriting().",
      "autoResize": true,
      "lineHeight": 1.25
    },
